# Formspree form ID for the connect form (https://formspree.io)

# WhatsApp number with country code, digits only (e.g. 919XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_URL_JJPRO=https://jjpro.in
NEXT_PUBLIC_URL_JJFUND=https://jjfund.com
NEXT_PUBLIC_URL_MYTH=https://myth-ai.com/in
NEXT_PUBLIC_URL_PHOENIX=https://phoenixglobal.biz

# ---------------------------------------------------------------------------
# Form delivery. ALL website enquiries must reach: jignesh@myth-ai.com
# Activation steps (needs access to that inbox, do once):
#   1. Sign in at https://formspree.io with jignesh@myth-ai.com (or create the account with it).
#   2. New form > set the notification email to jignesh@myth-ai.com and confirm the verification email.
#   3. Copy the form ID (the part after /f/) into NEXT_PUBLIC_FORMSPREE_ID in Vercel and redeploy.
# Until the ID is set, forms show a "not connected yet, use WhatsApp" message instead of failing silently.
NEXT_PUBLIC_FORMSPREE_ID=
NEXT_PUBLIC_FORM_TARGET_EMAIL=jignesh@myth-ai.com

# ---------------------------------------------------------------------------
# Analytics and verification. Everything is OFF until a value is set.
# Google Analytics 4 (analytics.google.com > Admin > Data streams > Measurement ID)
NEXT_PUBLIC_GA_ID=
# Google Search Console (search.google.com/search-console > HTML tag method: paste only the content value)
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools verification content value
NEXT_PUBLIC_BING_VERIFICATION=
# LinkedIn Insight Tag partner ID (Campaign Manager > Insight Tag)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# Microsoft Clarity project ID (clarity.microsoft.com)
NEXT_PUBLIC_CLARITY_ID=
