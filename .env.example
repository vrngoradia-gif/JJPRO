# Formspree form ID — https://formspree.io
# Used by components/forms/ContactForm.tsx for the Contact and Partner forms.
NEXT_PUBLIC_FORMSPREE_ID=YOUR_FORM_ID

# Calendly scheduling link — used by components/forms/CalendlyEmbed.tsx
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/jigjain/30min

# WhatsApp number with country code, digits only (e.g. 919XXXXXXXXX). Powers the WhatsApp button and chat handoff.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Final domains of the four sites, used for cross-links
NEXT_PUBLIC_URL_JJPRO=https://jjpro.in
NEXT_PUBLIC_URL_JJFUND=https://jjfund.com
NEXT_PUBLIC_URL_MYTH=https://myth-ai.com/in
NEXT_PUBLIC_URL_PHOENIX=https://phoenixglobal.biz
